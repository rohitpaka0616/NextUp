# ── Database ─────────────────────────────────────────────
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE

# ── Auth.js / NextAuth v5 ───────────────────────────────
# Generate once: openssl rand -base64 32
AUTH_SECRET=

# Canonical site URL (no trailing slash).
# Local:        http://localhost:3000
# Vercel + domain: https://your-domain.com
AUTH_URL=http://localhost:3000

# Aliases (optional; same values as above):
# NEXTAUTH_SECRET=
# NEXTAUTH_URL=

# ── App ─────────────────────────────────────────────────
# Email that receives admin API privileges (see ADMIN_EMAIL usage in API routes).
ADMIN_EMAIL=you@example.com

# ── GitHub Org Repo Provisioning (optional) ─────────────
# Fine-grained PAT with "Administration: Read and write" for repositories.
GITHUB_ORG_TOKEN=
# Target org where new repos should be created.
GITHUB_ORG_NAME=NextUpDesign

# ── LocalMod content moderation (optional) ───────────────
# Self-hosted LocalMod API (see docker-compose localmod service).
# When unset, moderation is skipped. When set, create/update/comment routes call /analyze.
LOCALMOD_URL=http://localhost:8000
# Classifiers to run (default: toxicity,nsfw)
# LOCALMOD_CLASSIFIERS=toxicity,nsfw
# Block only when confidence >= this (default 0.75) or severity is high/critical
# LOCALMOD_MIN_CONFIDENCE=0.75
# Request timeout in ms (CPU + first model load can be slow; default 120000)
# LOCALMOD_TIMEOUT_MS=120000
# If true, allow posts when LocalMod is unreachable (dev only)
# LOCALMOD_FAIL_OPEN=false

# ── AI Idea Generation (optional) ───────────────────────
# Use an OpenAI-compatible endpoint.
# Default base URL is OpenAI if OPENAI_BASE_URL is not set.
OPENAI_API_KEY=
# Optional: defaults to gpt-4o-mini
OPENAI_MODEL=gpt-4o-mini
# Optional: for other providers (OpenAI-compatible)
# OPENAI_BASE_URL=https://api.openai.com/v1
